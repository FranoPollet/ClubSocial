<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:models="clr-namespace:ClubSocial.Models"
    xmlns:viewmodels="clr-namespace:ClubSocial.ViewModels"
    x:Class="ClubSocial.MainPage"
    x:DataType="viewmodels:SociosViewModel"
    Title="Socios del club"
    BackgroundColor="#F5F5F5">

    <Grid Padding="16"
          RowDefinitions="Auto,Auto,Auto,*"
          RowSpacing="12">

        <Label
            Grid.Row="0"
            Text="Club Social - Administración"
            FontSize="22"
            FontAttributes="Bold"
            TextColor="#203A54" />

        <VerticalStackLayout Grid.Row="1" Spacing="6">

            <HorizontalStackLayout Spacing="10">

                <Button
                    Text="Cargar socios"
                    Command="{Binding CargarSociosCommand}"
                    BackgroundColor="#203A54"
                    TextColor="White" />

                <ActivityIndicator
                    IsRunning="{Binding EstaOcupado}"
                    IsVisible="{Binding EstaOcupado}"
                    Color="#203A54"
                    VerticalOptions="Center" />

            </HorizontalStackLayout>

            <Label
                Text="{Binding Mensaje}"
                TextColor="#333333"
                FontSize="14" />

        </VerticalStackLayout>

        <VerticalStackLayout Grid.Row="2" Spacing="8">

            <Label
                Text="{Binding TituloFormulario}"
                FontSize="18"
                FontAttributes="Bold"
                TextColor="#203A54" />

            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">

                <Entry
                    Grid.Column="0"
                    Placeholder="Nombre"
                    Text="{Binding Nombre, Mode=TwoWay}"
                    TextColor="#222222"
                    PlaceholderColor="#666666" />

                <Entry
                    Grid.Column="1"
                    Placeholder="Apellido"
                    Text="{Binding Apellido, Mode=TwoWay}"
                    TextColor="#222222"
                    PlaceholderColor="#666666" />

            </Grid>

            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">

                <Entry
                    Grid.Column="0"
                    Placeholder="DNI sin puntos"
                    Keyboard="Numeric"
                    MaxLength="8"
                    Text="{Binding Dni, Mode=TwoWay}"
                    TextColor="#222222"
                    PlaceholderColor="#666666" />

                <Entry
                    Grid.Column="1"
                    Placeholder="Teléfono"
                    Keyboard="Telephone"
                    Text="{Binding Telefono, Mode=TwoWay}"
                    TextColor="#222222"
                    PlaceholderColor="#666666" />

            </Grid>

            <Entry
                Placeholder="Email (opcional)"
                Keyboard="Email"
                Text="{Binding Email, Mode=TwoWay}"
                TextColor="#222222"
                PlaceholderColor="#666666" />

            <Picker
                Title="Seleccioná un sector"
                ItemsSource="{Binding Sectores}"
                SelectedItem="{Binding SectorSeleccionado, Mode=TwoWay}"
                TextColor="#222222"
                TitleColor="#666666" />

            <HorizontalStackLayout Spacing="10">

                <Label
                    Text="Socio activo"
                    TextColor="#222222"
                    VerticalOptions="Center" />

                <Switch
                    IsToggled="{Binding Activo, Mode=TwoWay}"
                    OnColor="#203A54" />

            </HorizontalStackLayout>

            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">

                <Button
                    Grid.Column="0"
                    Text="Guardar socio"
                    Command="{Binding GuardarSocioCommand}"
                    BackgroundColor="#203A54"
                    TextColor="White" />

                <Button
                    Grid.Column="1"
                    Text="Nuevo / Cancelar edición"
                    Command="{Binding NuevoSocioCommand}"
                    BackgroundColor="#DDDDDD"
                    TextColor="#222222" />

            </Grid>

        </VerticalStackLayout>

        <CollectionView
            Grid.Row="3"
            ItemsSource="{Binding Socios}"
            SelectionMode="None">

            <CollectionView.EmptyView>
                <Label
                    Text="No hay socios en la lista. Cargá los registros o agregá uno."
                    Margin="0,12"
                    TextColor="#555555" />
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>

                <DataTemplate x:DataType="models:Socio">

                    <VerticalStackLayout
                        Padding="10"
                        Spacing="5">

                        <HorizontalStackLayout Spacing="5">

                            <Label
                                Text="{Binding Apellido}"
                                FontAttributes="Bold"
                                TextColor="#222222" />

                            <Label
                                Text="{Binding Nombre}"
                                FontAttributes="Bold"
                                TextColor="#222222" />

                        </HorizontalStackLayout>

                        <Label
                            Text="{Binding Dni, StringFormat='DNI: {0}'}"
                            TextColor="#444444" />

                        <Label
                            Text="{Binding Sector, StringFormat='Sector: {0}'}"
                            TextColor="#444444" />

                        <Label
                            Text="{Binding Activo, StringFormat='Activo: {0}'}"
                            TextColor="#444444" />

                        <HorizontalStackLayout Spacing="10">

                            <Button
                                Text="Editar"
                                BackgroundColor="#203A54"
                                TextColor="White"
                                Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:SociosViewModel}}, Path=EditarSocioCommand}"
                                CommandParameter="{Binding .}" />

                            <Button
                                Text="Eliminar"
                                BackgroundColor="#A83232"
                                TextColor="White"
                                Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:SociosViewModel}}, Path=EliminarSocioCommand}"
                                CommandParameter="{Binding .}" />

                        </HorizontalStackLayout>

                        <BoxView
                            HeightRequest="1"
                            BackgroundColor="#CCCCCC"
                            Margin="0,5" />

                    </VerticalStackLayout>

                </DataTemplate>

            </CollectionView.ItemTemplate>

        </CollectionView>

    </Grid>

</ContentPage>