<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ClubSocial.Views.ClimaPage"
             Title="ClimaPage"
             x:DataType="viewmodels:ClimaViewModel"
             xmlns:models="clr-namespace:ClubSocial.Models"
             xmlns:viewmodels="clr-namespace:ClubSocial.ViewModels"
             BackgroundColor="#EEF2F5">

    <Grid
        Padding="16"
        RowDefinitions="Auto,Auto,Auto,Auto,*,Auto"
        RowSpacing="12">

        <VerticalStackLayout Grid.Row="0" Spacing="5">

            <Label
                Text="Clima para las actividades"
                FontSize="24"
                FontAttributes="Bold"
                TextColor="#203A54" />

            <Label
                Text="Buenos Aires · Ubicación de ejemplo"
                TextColor="#526171" />

            <Label
                Text="Consultá el pronóstico para organizar actividades al aire libre."
                TextColor="#526171" />

        </VerticalStackLayout>

        <Button
            Grid.Row="1"
            Text="Cargar datos"
            Command="{Binding CargarDatosCommand}"
            BackgroundColor="#203A54"
            TextColor="White"
            CornerRadius="8"
            MinimumHeightRequest="48" />

        <Grid
            Grid.Row="2"
            ColumnDefinitions="Auto,*"
            ColumnSpacing="10">

            <ActivityIndicator
                Grid.Column="0"
                IsRunning="{Binding EstaOcupado}"
                IsVisible="{Binding EstaOcupado}"
                Color="#203A54"
                VerticalOptions="Center" />

            <Label
                Grid.Column="1"
                Text="{Binding Mensaje}"
                TextColor="#203A54"
                LineBreakMode="WordWrap"
                VerticalOptions="Center" />

        </Grid>

        <Label
            Grid.Row="3"
            Text="Tocá un día para consultar su detalle."
            TextColor="#526171" />

        <CollectionView
            Grid.Row="4"
            ItemsSource="{Binding Dias}"
            SelectionMode="Single"
            SelectedItem="{Binding DiaSeleccionado, Mode=TwoWay}"
            SelectionChangedCommand="{Binding VerDetalleCommand}">

            <CollectionView.EmptyView>

                <Label
                    Text="Todavía no hay pronósticos cargados."
                    TextColor="#526171"
                    Margin="0,15" />

            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>

                <DataTemplate x:DataType="models:PronosticoDia">

                    <Border
                        BackgroundColor="White"
                        Stroke="#D6DEE6"
                        StrokeThickness="1"
                        Padding="16"
                        Margin="0,0,0,10">

                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="10" />
                        </Border.StrokeShape>

                        <VerticalStackLayout Spacing="7">

                            <Label
                                Text="{Binding Fecha, StringFormat='{0:dd/MM/yyyy}'}"
                                FontSize="19"
                                FontAttributes="Bold"
                                TextColor="#172B3A" />

                            <Label
                                Text="{Binding TemperaturaMinima, StringFormat='Mínima: {0:F1} °C'}"
                                TextColor="#526171" />

                            <Label
                                Text="{Binding TemperaturaMaxima, StringFormat='Máxima: {0:F1} °C'}"
                                TextColor="#526171" />

                            <Label
                                Text="{Binding ProbabilidadLluvia, StringFormat='Probabilidad máxima de precipitación: {0:F0} %'}"
                                TextColor="#203A54" />

                        </VerticalStackLayout>

                    </Border>

                </DataTemplate>

            </CollectionView.ItemTemplate>

        </CollectionView>

        <Label
            Grid.Row="5"
            Text="Fuente: Open-Meteo · open-meteo.com · CC BY 4.0"
            FontSize="12"
            TextColor="#526171" />

    </Grid>


</ContentPage>