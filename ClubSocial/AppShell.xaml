<?xml version="1.0" encoding="utf-8" ?>

<Shell
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="ClubSocial.AppShell"
    Title="Club Social"
    FlyoutBehavior="Disabled"
    BackgroundColor="#203A54"
    ForegroundColor="White"
    TitleColor="White"
    Shell.TabBarBackgroundColor="White"
    Shell.TabBarForegroundColor="#203A54"
    Shell.TabBarTitleColor="#203A54"
    Shell.TabBarUnselectedColor="#526171">

    <TabBar>

        <Tab Title="Socios">

            <ShellContent
                x:Name="SociosContent"
                Title="Socios"
                Route="socios" />

        </Tab>

        <Tab Title="Clima">

            <ShellContent
                x:Name="ClimaContent"
                Title="Clima"
                Route="clima" />

        </Tab>

    </TabBar>

</Shell>